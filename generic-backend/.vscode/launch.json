{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: import_results",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": [
        "import_results",
        "${input:importFile}",
      ],
      "django": true,
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Django: Runserver",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": [
        "runserver",
        "8000"
      ],
      "django": true,
      "justMyCode": false,
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "importFile",
      "type": "promptString",
      "description": "Path to the .xlsx file to import"
    }
  ]
}
