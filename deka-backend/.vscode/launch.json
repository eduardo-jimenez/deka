{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: import_results",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": [
        "import_results",
        "${input:importFile}",
        "--event",
        "${input:eventName}"
      ],
      "django": true,
      "justMyCode": false,
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "importFile",
      "type": "promptString",
      "description": "Path to the .xlsx file to import"
    },
    {
      "id": "eventName",
      "type": "promptString",
      "description": "Event name to use (optional)",
      "default": ""
    }
  ]
}
